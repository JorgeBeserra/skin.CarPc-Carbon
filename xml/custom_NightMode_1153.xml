<?xml version="1.0" encoding="UTF-8"?>
<!-- Visible condition makes this a modeless dialog: inputs pass to the UI below.
     The opaque square texture is tinted black at 70% opacity.
     This dims the rendered image, not the physical backlight. -->
<window id="1153" type="dialog">
    <visible>String.IsEqual(Window(Home).Property(carpc_night_mode),true)</visible>
    <zorder>99</zorder>
    <coordinates>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>
    <controls>
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1706</width>
            <height>960</height>
            <texture colordiffuse="B3000000">square.png</texture>
        </control>
    </controls>
</window>
