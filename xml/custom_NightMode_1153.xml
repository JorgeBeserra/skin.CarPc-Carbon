<?xml version="1.0" encoding="UTF-8"?>
<!-- Visible condition makes this a modeless dialog: inputs pass to the UI below.
     carpc_night_mode is set by service.py from the car light sensor (CAN 0x3B3, byte 1).
     The opaque square texture is tinted black (Skin.String NightDimLevel: Low 50%, Medium 70%
     default, High 85%). This dims the rendered image, not the physical backlight. -->
<window id="1153" type="dialog">
    <visible>String.IsEqual(Window(Home).Property(carpc_night_mode),true) + !Skin.HasSetting(DisableNightDim)</visible>
    <zorder>99</zorder>
    <animation effect="fade" time="1500">WindowOpen</animation>
    <animation effect="fade" time="1500">WindowClose</animation>
    <coordinates>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>
    <controls>
        <control type="image">
            <visible>String.IsEqual(Skin.String(NightDimLevel),Low)</visible>
            <posx>0</posx>
            <posy>0</posy>
            <width>1706</width>
            <height>960</height>
            <texture colordiffuse="80000000">square.png</texture>
            <animation effect="fade" time="1500">VisibleChange</animation>
        </control>
        <control type="image">
            <visible>!String.IsEqual(Skin.String(NightDimLevel),Low) + !String.IsEqual(Skin.String(NightDimLevel),High)</visible>
            <posx>0</posx>
            <posy>0</posy>
            <width>1706</width>
            <height>960</height>
            <texture colordiffuse="B3000000">square.png</texture>
            <animation effect="fade" time="1500">VisibleChange</animation>
        </control>
        <control type="image">
            <visible>String.IsEqual(Skin.String(NightDimLevel),High)</visible>
            <posx>0</posx>
            <posy>0</posy>
            <width>1706</width>
            <height>960</height>
            <texture colordiffuse="D9000000">square.png</texture>
            <animation effect="fade" time="1500">VisibleChange</animation>
        </control>
    </controls>
</window>
