			<description>Linha de status</description>
			<posx>20</posx>
			<posy>670</posy>
			<width>1060</width>
			<height>70</height>
			<align>left</align>
			<aligny>center</aligny>
			<font>font20_title</font>
			<textcolor>white</textcolor>
			<label></label>
		</control>
