				<disabledcolor>60FFFFFF</disabledcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus>dialogbutton-focus.png</texturefocus>
				<texturenofocus>dialogbutton-nofocus.png</texturenofocus>
			</control>
			<control type="button" id="9004">
				<description>Abre as configuracoes do LibreELEC</description>
				<width>270</width>
				<height>100</height>
