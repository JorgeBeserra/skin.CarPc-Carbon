		<control type="image">
			<posx>0</posx>
			<posy>0</posy>
			<width>1100</width>
			<height>70</height>
			<texture border="5">dialog_header.png</texture>
		</control>
		<control type="image">
			<posx>0</posx>
			<posy>70</posy>
			<width>1100</width>
			<height>690</height>
			<texture>dialog_back.png</texture>
		</control>
		<control type="label" id="1">
			<description>Titulo</description>
			<posx>20</posx>
			<posy>5</posy>
			<include>WindowTitleCommons</include>
			<width>300</width>
			<label>Bluetooth</label>
		</control>
		<control type="label" id="2">
			<description>Estado do adaptador</description>
			<posx>330</posx>
			<posy>5</posy>
			<width>680</width>
			<height>60</height>
			<align>right</align>
			<aligny>center</aligny>
			<font>font20_title</font>
			<textcolor>grey</textcolor>
			<label></label>
		</control>
		<control type="group">
			<posx>1030</posx>
			<posy>5</posy>
			<include>DialogCloseButtonCommons</include>
		</control>

		<!-- Lista de dispositivos -->
		<control type="image">
			<posx>20</posx>
			<posy>90</posy>
			<width>770</width>
			<height>560</height>
			<texture colordiffuse="40000000">panel.png</texture>
		</control>
		<control type="label" id="4">
			<description>Mensagem com a lista vazia</description>
			<posx>40</posx>
			<posy>90</posy>
			<width>730</width>
			<height>560</height>
			<align>center</align>
			<aligny>center</aligny>
			<font>font20_title</font>
			<textcolor>grey</textcolor>
			<wrapmultiline>true</wrapmultiline>
			<label></label>
			<visible>Integer.IsEqual(Container(50).NumItems,0)</visible>
		</control>
		<control type="list" id="50">
			<posx>20</posx>
			<posy>90</posy>
			<width>740</width>
			<height>560</height>
			<onup>50</onup>
			<ondown>50</ondown>
			<onleft>9001</onleft>
			<onright>9001</onright>
			<pagecontrol>60</pagecontrol>
			<scrolltime>200</scrolltime>
			<itemlayout height="80" width="740">
				<control type="label">
					<posx>20</posx>
					<posy>0</posy>
					<width>470</width>
					<height>80</height>
					<font>font24_title</font>
					<align>left</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<posx>720</posx>
					<posy>0</posy>
					<width>220</width>
					<height>80</height>
					<font>font20_title</font>
					<textcolor>grey</textcolor>
					<align>right</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>
			<focusedlayout height="80" width="740">
				<control type="image">
					<posx>0</posx>
					<posy>0</posy>
					<width>740</width>
					<height>80</height>
					<texture>list_focus.png</texture>
				</control>
				<control type="label">
					<posx>20</posx>
					<posy>0</posy>
					<width>470</width>
					<height>80</height>
					<font>font24_title</font>
					<align>left</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<posx>720</posx>
					<posy>0</posy>
					<width>220</width>
					<height>80</height>
					<font>font20_title</font>
					<align>right</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</focusedlayout>
		</control>
		<control type="scrollbar" id="60">
			<posx>764</posx>
			<posy>100</posy>
			<width>26</width>
			<height>540</height>
			<texturesliderbackground colordiffuse="30FFFFFF">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="grey">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="blue">white.png</texturesliderbarfocus>
			<textureslidernib>blank.png</textureslidernib>
			<textureslidernibfocus>blank.png</textureslidernibfocus>
			<onleft>50</onleft>
			<onright>9001</onright>
			<showonepage>false</showonepage>
			<orientation>vertical</orientation>
		</control>

