				<font>font24_title</font>
				<textcolor>FFFFFFFF</textcolor>
				<focusedcolor>FF00A8FF</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus>dialogbutton-focus.png</texturefocus>
				<texturenofocus>dialogbutton-nofocus.png</texturenofocus>
			</control>
			<control type="button" id="9005">
				<description>Fechar</description>
				<width>270</width>
				<height>100</height>
				<label>Fechar</label>
				<font>font24_title</font>
				<textcolor>FFFFFFFF</textcolor>
				<focusedcolor>FF00A8FF</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus>dialogbutton-focus.png</texturefocus>
				<texturenofocus>dialogbutton-nofocus.png</texturenofocus>
